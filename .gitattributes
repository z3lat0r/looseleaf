# Normalise text files in the repository
* text=auto

# PowerShell: CRLF in the working tree (Windows-native tool, PowerShell 5.1 baseline)
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf

# Everything else: LF
*.md    text eol=lf
*.json  text eol=lf
*.lua   text eol=lf
*.yml   text eol=lf

# Binary fixtures
*.docx  binary
*.pdf   binary
*.png   binary
*.jpg   binary
