root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Windows PowerShell 5.1 reads BOM-less files as ANSI: always save with BOM.
[*.{ps1,psm1,psd1}]
charset = utf-8-bom
end_of_line = crlf

[*.{md,json,yml,yaml,lua}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
